# JIS Router Configuration
# Copy this file to .env and customize for your deployment

# Database Configuration
POSTGRES_USER=jis
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=jis

# Router Security
JIS_SHARED_SECRET=changeme_very_secure_secret
JWT_SECRET=  # Optional: JWT secret for Bearer token auth (HS256)
JWT_AUDIENCE=  # Optional: JWT audience claim
JWT_ISSUER=  # Optional: JWT issuer claim

# Rate Limiting
RATE_LIMIT=60  # requests per window
RATE_WINDOW=60  # window in seconds

# Intent/Role Whitelists (comma-separated)
ALLOWED_INTENTS=  # Example: unlock_door,send_message,verify_identity
ALLOWED_ROLES=  # Example: client,server,device,admin

# Optional JWT Token for bridges
JWT_TOKEN=  # If using JWT auth, generate a token for bridges
